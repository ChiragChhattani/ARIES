# === ARIES Environment Configuration ===
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Application ---
ARIES_ENV=development
ARIES_LOG_LEVEL=DEBUG
ARIES_APP_NAME=ARIES
ARIES_APP_VERSION=0.1.0

# --- Database ---
# SQLite for local dev. Change to postgresql+asyncpg://... for production.
ARIES_DATABASE_URL=sqlite+aiosqlite:///./aries.db

# --- CORS ---
# Comma-separated origins allowed to access the API.
ARIES_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM Configuration ---
# Choose between "openai" or "groq"
ARIES_LLM_PROVIDER=groq

# If using Groq:
GROQ_API_KEY=gsk-your-groq-api-key-here
ARIES_GROQ_MODEL=llama-3.3-70b-versatile

# If using OpenAI:
OPENAI_API_KEY=sk-your-openai-api-key-here
ARIES_OPENAI_MODEL=gpt-4o

ARIES_OPENAI_MAX_TOKENS=4096
ARIES_OPENAI_TEMPERATURE=0.7

# --- Interview Defaults ---
ARIES_DEFAULT_MAX_QUESTIONS=10
ARIES_DEFAULT_TIMEOUT_MINUTES=45
